{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD Reader",
  "version": "1.0.0",
  "identifier": "com.mdreader.app",
  "build": {
    "beforeDevCommand": "npm run dev -w @md-reader/client",
    "beforeBuildCommand": "npm run build -w @md-reader/client",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MD Reader",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
